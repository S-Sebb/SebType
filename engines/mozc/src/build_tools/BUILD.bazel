# Description:
#   Contains tools which are required to build mozc.

load(
    "//:build_defs.bzl",
    "mozc_py_binary",
    "mozc_py_library",
)

package(default_visibility = ["//:__subpackages__"])

mozc_py_library(
    name = "code_generator_util",
    srcs = ["code_generator_util.py"],
)

mozc_py_library(
    name = "mozc_version_lib",
    srcs = ["mozc_version.py"],
)

mozc_py_binary(
    name = "mozc_version",
    srcs = ["mozc_version.py"],
)

mozc_py_binary(
    name = "replace_version",
    srcs = ["replace_version.py"],
    deps = [":mozc_version_lib"],
)

mozc_py_binary(
    name = "embed_file",
    srcs = ["embed_file.py"],
)

mozc_py_library(
    name = "serialized_string_array_builder",
    srcs = ["serialized_string_array_builder.py"],
)

exports_files([
    "mozc_win32_resource_template.rc",
])

mozc_py_binary(
    name = "gen_win32_resource_header",
    srcs = ["gen_win32_resource_header.py"],
    deps = [":mozc_version_lib"],
)
