load(
    "//:build_defs.bzl",
    "mozc_cc_library",
    "mozc_select_enable_session_watchdog",
)

package(default_visibility = ["//visibility:private"])

mozc_cc_library(
    name = "session",
    srcs = ["session.cc"],
    hdrs = ["session.h"],
    visibility = [
    ],
    deps = [
        ":ime_context",
        ":key_event_transformer",
        ":keymap",
        "//base:clock",
        "//base:util",
        "//composer",
        "//composer:key_event_util",
        "//composer:table",
