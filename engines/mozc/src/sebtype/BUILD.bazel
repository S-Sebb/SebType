# SebType: Mozc in SebType's process (#220, #233), behind the C interface in core/src/sebtype_mozc.h: the
# phone's libmozc.so (//android/jni:mozc), the Fcitx5 add-on's libsebtype-mozc.so and sebtype-server.exe's
# sebtype-mozc.dll. Each library exports only that interface, so Mozc's protobuf and Abseil stay inside it.

load(
    "//:build_defs.bzl",
    "mozc_cc_binary",
    "mozc_cc_library",
    "mozc_select",
    "mozc_win32_cc_prod_binary",
)

exports_files(["sebtype_mozc.map"])

mozc_cc_library(
    name = "sebtype_mozc",
    srcs = ["sebtype_mozc.cc"],
    linkopts = mozc_select(
        android = ["-llog"],
    ),
    visibility = ["//android/jni:__pkg__"],
    deps = [
        "//base:system_util",
        "//client/user_dictionary:user_dictionary_importer",
        "//config:config_handler",
        "//data_manager",
        "//engine",
        "//protocol:commands_cc_proto",
        "//protocol:user_dictionary_storage_cc_proto",
        "//session:session_handler",
        "@com_google_absl//absl/log",
        "@com_google_absl//absl/log:check",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
    ] + mozc_select(
        # The PCs' dictionary is built in; the phone's is a file in the APK.
        android = [],
        default = ["//engine:engine_factory"],
    ),
    alwayslink = 1,
)

# Linux: installed as %{_libdir}/sebtype/libsebtype-mozc.so (linux/sebtype.spec).
mozc_cc_binary(
    name = "libsebtype-mozc.so",
    additional_linker_inputs = ["sebtype_mozc.map"],
    linkopts = [
        "-Wl,--version-script=$(location sebtype_mozc.map)",
        "-Wl,--gc-sections",
        "-Wl,-soname,libsebtype-mozc.so",
    ],
    linkshared = 1,
    target_compatible_with = ["@platforms//os:linux"],
    deps = [":sebtype_mozc"],
)

# Windows: sebtype-mozc.dll next to sebtype-server.exe (pc/windows/mozc/build.ps1). The C++ runtime is
# linked in, so the DLL needs nothing but Windows' own.
mozc_win32_cc_prod_binary(
    name = "sebtype_mozc_win",
    executable_name_map = {
        "Mozc": "sebtype-mozc.dll",
    },
    linkshared = True,
    static_crt = True,
    win_def_file = "sebtype_mozc.def",
    deps = [":sebtype_mozc"],
)
