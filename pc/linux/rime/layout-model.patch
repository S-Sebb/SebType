+// SebType (#101): a PC hits a neighbour key, the vertical ones included, which
+// librime's own map above lacks: keys whose centres are within 1.25 key widths
+// on the staggered ANSI rows. Each slip costs -log P(typed | meant): the
+// substitution rate (Dhakal et al. 2018) shared among the meant key's
+// neighbours, as tools/rime-data/sebtype_typo.lua prices it.
+KeyboardModel KeyboardModel::Pc() {
+  const char* rows[] = {"qwertyuiop", "asdfghjkl", "zxcvbnm"};
+  const double stagger[] = {0, 0.25, 0.75};
+  const double kSubstitution = 0.0165, kReach = 1.25, kFar = 1e-3;
+  hash_map<char, std::pair<double, double>> pos;
+  for (int r = 0; r < 3; ++r)
+    for (int i = 0; rows[r][i]; ++i)
+      pos[rows[r][i]] = {i + stagger[r], r};
+  auto near = [&](char a, char b) {
+    double dx = pos[a].first - pos[b].first, dy = pos[a].second - pos[b].second;
+    return a != b && dx * dx + dy * dy <= kReach * kReach;
+  };
+  KeyboardModel model;
+  for (auto& [meant, p] : pos) {
+    double total = 0;
+    for (auto& [typed, q] : pos)
+      if (typed != meant)
+        total += near(meant, typed) ? 1 : kFar;
+    for (auto& [typed, q] : pos)
+      if (near(meant, typed))
+        model.slips[typed].push_back(
+            {meant, -std::log(kSubstitution) - std::log(1 / total)});
+  }
+  return model;
+}
