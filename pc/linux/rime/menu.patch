@@ -113,6 +114,37 @@ std::vector<std::string> getListItemString(rime_api_t *api, RimeConfig *config,
     return values;
 }
 
+// SebType: the key that switches each option at any time, from the "when: always" bindings of
+// default.yaml's key_binder, which rime-ice's schema imports. The first binding of an option wins.
+std::unordered_map<std::string, std::string> toggleKeys(rime_api_t *api) {
+    std::unordered_map<std::string, std::string> keys;
+    RimeConfig config{};
+    if (!api->config_open("default", &config)) {
+        return keys;
+    }
+    for (const auto &path : getListItemPath(api, &config, "key_binder/bindings")) {
+        const auto *when = api->config_get_cstring(&config, (path + "/when").c_str());
+        const auto *toggle = api->config_get_cstring(&config, (path + "/toggle").c_str());
+        const auto *accept = api->config_get_cstring(&config, (path + "/accept").c_str());
+        if (when && toggle && accept && std::string_view(when) == "always") {
+            keys.emplace(toggle, accept);
+        }
+    }
+    api->config_close(&config);
+    return keys;
+}
+
+// SebType: a Rime key as Windows and the menus write it: Control+Shift+f → Ctrl+Shift+F.
+std::string keyLabel(std::string key) {
+    if (stringutils::startsWith(key, "Control+")) {
+        key.replace(0, 7, "Ctrl");
+    }
+    if (key.size() >= 2 && key[key.size() - 2] == '+') {
+        key.back() = charutils::toupper(key.back());
+    }
+    return key;
+}
