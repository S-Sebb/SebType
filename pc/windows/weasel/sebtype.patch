+// SebType (#94): a column at the start for SebType's pig, as tall as a
+// candidate row plus half the margins, so it follows the font size and DPI.
+// Everything laid out so far moves right by the column; height is the
+// content height inside the border.
+void StandardLayout::ReserveLogoColumn(int* width, int height) {
+  if (!_style.sebtype_logo || !candidates_count)
+    return;
+  const int h = _candidateRects[0].Height() + real_margin_y;
+  const int w = h * LOGO_WIDTH / LOGO_HEIGHT;
+  const int top = offsetY + (height - h) / 2;
+  _logoRect.SetRect(offsetX + real_margin_x, top,
+                    offsetX + real_margin_x + w, top + h);
+  const int shift = w + real_margin_x / 2;
+  for (CRect* rc : {&_preeditRect, &_auxiliaryRect, &_highlightRect,
+                    &_statusIconRect})
+    rc->OffsetRect(shift, 0);
+  for (auto i = 0; i < candidates_count && i < MAX_CANDIDATES_COUNT; ++i) {
+    _candidateRects[i].OffsetRect(shift, 0);
+    _candidateLabelRects[i].OffsetRect(shift, 0);
+    _candidateTextRects[i].OffsetRect(shift, 0);
+    _candidateCommentRects[i].OffsetRect(shift, 0);
+  }
+  *width += shift;
+}
