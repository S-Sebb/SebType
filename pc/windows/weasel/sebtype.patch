   }
 }
 
+// SebType (#94): a column at the start for SebType's pig, 10/7 of a
+// candidate row plus half the margins (#162), so it follows the font size and
+// DPI; its top is level with the first row (the pinyin when it is shown) and
+// it stays inside the content. Everything laid out so far moves right by the
+// column; height is the content height inside the border.
+void StandardLayout::ReserveLogoColumn(int* width, int height, float scale) {
+  if (_style.sebtype_logo.empty() || !candidates_count)
+    return;
+  int top = _candidateRects[0].top;
+  for (const CRect* rc : {&_preeditRect, &_auxiliaryRect})
+    if (!rc->IsRectEmpty())
+      top = min(top, rc->top);
+  const int h = min((_candidateRects[0].Height() + real_margin_y) * 10 / 7,
+                    height);
+  const int w = h * LOGO_WIDTH / LOGO_HEIGHT;
+  top = min(top, offsetY + height - h);
+  _logoRect.SetRect(offsetX + real_margin_x, top,
+                    offsetX + real_margin_x + w, top + h);
+  const int shift = w + real_margin_x / 2 + (int)(LOGO_GAP * scale);
+  for (CRect* rc : {&_preeditRect, &_auxiliaryRect, &_highlightRect,
+                    &_statusIconRect})
+    rc->OffsetRect(shift, 0);
+  for (auto i = 0; i < candidates_count && i < MAX_CANDIDATES_COUNT; ++i) {
+    _candidateRects[i].OffsetRect(shift, 0);
+    _candidateLabelRects[i].OffsetRect(shift, 0);
+    _candidateTextRects[i].OffsetRect(shift, 0);
+    _candidateCommentRects[i].OffsetRect(shift, 0);
+  }
+  *width += shift;
+}
