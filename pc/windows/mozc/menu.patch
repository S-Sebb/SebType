+size_t TipLangBarButton::KanaSwitch(const wchar_t** label) {
+  bool katakana = false;
+  for (size_t i = 0; i < menu_data_size(); ++i) {
+    const TipLangBarMenuData* data = menu_data(i);
+    if ((data->flags_ & TF_LBMENUF_RADIOCHECKED) != 0) {
+      katakana = data->item_id_ == TipLangBarCallback::kFullKatakana ||
+                 data->item_id_ == TipLangBarCallback::kHalfKatakana;
+    }
+  }
+  *label = katakana ? L"\u30a2 \u2192 \u3042\tAlt+`"   // ア → あ
+                    : L"\u3042 \u2192 \u30a2\tAlt+`";  // あ → ア
+  const UINT target = katakana ? TipLangBarCallback::kHiragana
+                               : TipLangBarCallback::kFullKatakana;
+  for (size_t i = 0; i < menu_data_size(); ++i) {
+    if (menu_data(i)->item_id_ == target) {
+      return i;
+    }
+  }
+  return 0;
+}
