// Every setting the window shows, and the callbacks that apply a change. src/main.rs fills and handles them.
// Every word the window shows is here or in the other .slint files, in English inside @tr; lang/ holds the
// 中文 and 日本語 (#118).
export struct Lang { id: string, on: bool }   // id: "en", "zh" or "ja"
export struct Fuzzy { label: string, on: bool }
export struct ZhWord { word: string, code: string }
export struct JaWord { reading: string, word: string, pos: int }

export enum Msg {
    none, applied, zh-redeployed, ja-next-time, theme-next-time, saved-zh, saved-ja, deleted-zh, deleted,
    nothing-learned, forgotten, exported, imported, not-a-backup, pinyin-letters-only,
    reading-hiragana-only, words-changed, word-gone, failed, sync-deleted, sync-delete-failed,
}

// What sync's switch says under it, as the phone's (ChineseSync.Status).
export enum SyncStatus { off, not-yet, syncing, synced, offline, login-failed }

// What a connection check found (#452), as the phone's (Sync.Check): none before one.
export enum SyncCheck { none, checking, connected, login-failed, unreachable, not-sebtype, tls }

export global SyncText {
    public pure function check(c: SyncCheck) -> string {
        if c == SyncCheck.checking { return @tr("Checking the server and login…"); }
        if c == SyncCheck.connected { return @tr("Connected. The server and login work"); }
        if c == SyncCheck.login-failed { return @tr("Wrong username or password"); }
        if c == SyncCheck.unreachable { return @tr("Can't reach the server. Check the address and your network"); }
        if c == SyncCheck.not-sebtype { return @tr("That address isn't a SebType sync server"); }
        if c == SyncCheck.tls { return @tr("The server's HTTPS certificate isn't trusted"); }
        return "";
    }
    public pure function failed(c: SyncCheck) -> bool {
        return c != SyncCheck.none && c != SyncCheck.checking && c != SyncCheck.connected;
    }
}

// The About page's update section (#422): the last check's outcome, then the install's steps.
export enum UpdateStatus { none, checking, up-to-date, available, offline, downloading, installing, installed, failed }

// One block of a GitHub release's patch notes (#428): kind 0 heading, 1 bullet, 2 plain text.
export struct UpdateNote { kind: int, heading: string, body: styled-text }

export global State {
    in property <string> version;
    in property <string> system;          // "Linux" or "Windows"
    in property <string> ui-font;
    in property <bool> zh-available: true;   // the engine's config folder exists
    in property <bool> ja-available: true;
    in property <bool> langs-ready;          // the language list has been read

    in-out property <[Lang]> langs;
    in property <int> langs-on;              // how many are on (one must stay on)
    in property <string> fuzzy-summary;      // the ones that are on, or "" for none
    in-out property <int> zh-script;          // 0 简体, 1 繁體
    in-out property <bool> zh-full-punct: true;
    in-out property <bool> zh-emoji: true;
    in-out property <[Fuzzy]> fuzzy;
    in-out property <[ZhWord]> zh-words;
    // My words' Add fields, and the row being edited (-1: none): an Edit that couldn't be saved stays
    // open, or goes into the Add fields when its word is gone (main.rs).
    in-out property <string> zh-add-word;
    in-out property <string> zh-add-code;
    in-out property <int> zh-editing: -1;
    in-out property <bool> ja-half-space;
    in-out property <[JaWord]> ja-words;
    in-out property <string> ja-add-reading;
    in-out property <string> ja-add-word;
    in-out property <int> ja-add-pos;
    in-out property <int> ja-editing: -1;
    // mozc::POS's order
    out property <[string]> ja-pos: [@tr("Noun"), @tr("Proper noun"), @tr("Person"), @tr("Place"), @tr("Organization"), @tr("Emoticon")];

    in-out property <int> page-size: 5;
    in-out property <bool> vertical;
    in-out property <int> font-size: 14;
    in-out property <bool> picnic: true;
    in-out property <bool> pinyin-row: true;
    in-out property <bool> learn: true;

    // Sync with the user's own server (#180)
    in-out property <bool> sync-on;
    in property <SyncStatus> sync-status;
    in property <string> sync-at;            // when the last sync went through, for synced
    in property <string> sync-server;        // the saved login, "" before the first
    in property <string> sync-user;
    in-out property <SyncCheck> sync-check;  // the saved login's last check (#452)
    in-out property <SyncCheck> login-check; // Server and login's, before it saves

    // Updates (#422)
    in-out property <bool> update-auto: true;   // Check for updates automatically
    in property <UpdateStatus> update-status;
    in property <string> update-version;        // the newer release's
    in property <string> update-installed;
    in property <string> update-checked;        // when the last check went through
    in property <string> update-error;          // why the check or the install failed
    in property <string> update-rime;           // after an update, the Fcitx5 groups where Rime won't type Chinese (#542)
    in property <int> update-rime-count;        // and how many
    callback use-sebtype-for-rime();            // SebType's input method in their place, as setup's wizard does
    in property <[UpdateNote]> update-notes;    // parsed release notes for update-version (#428)

    // What the last change did, shown for a moment (main.rs's toast); app.slint words it.
    in-out property <Msg> toast;
    in property <string> toast-arg;          // the file for exported, the error for failed
    out property <string> backup-file: @tr("SebType settings") + ".json";

    callback set-lang(int, bool);
    callback move-lang(int, int);
    callback zh-changed();
    callback fuzzy-changed(int, bool);
    callback add-zh-word(string, string) -> bool;
    callback edit-zh-word(int, string, string);   // row, word, pinyin: the editor closes once it's saved
    callback remove-zh-word(int);
    callback ja-changed();
    callback add-ja-word(string, string, int) -> bool;
    callback edit-ja-word(int, string, string, int);
    callback remove-ja-word(int);
    // My words' search: whether a word or its pinyin or reading has the text typed (all match "")
    pure callback word-matches(string, string, string) -> bool;
    callback candidates-changed();
    callback theme-changed();
    callback learn-changed();
    callback forget(string);   // "zh" or "ja"
    callback export-settings();
    callback import-settings();
    callback sync-toggled(bool);
    callback save-login(string, string, string) -> bool;   // server, user, password; false: not an https address
    // Checks a login and saves it if it works, then shows Sync & backup; false: not an https address.
    callback check-login(string, string, string) -> bool;
    callback check-connection();   // the saved login's
    callback delete-on-server();
    callback open-help();
    callback update-auto-changed();
    callback check-updates();
    callback install-update();
}
