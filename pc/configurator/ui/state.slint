// Every setting the window shows, and the callbacks that apply a change. src/main.rs fills and handles them.
// Every word the window shows is here or in the other .slint files, in English inside @tr; lang/ holds the
// 中文 and 日本語 (#118).
export struct Lang { id: string, on: bool }   // id: "en", "zh" or "ja"
export struct Fuzzy { label: string, on: bool }
export struct ZhWord { word: string, code: string }
export struct JaWord { reading: string, word: string, pos: int }

export enum Msg {
    none, applied, zh-redeployed, ja-next-time, theme-next-time, saved-zh, saved-ja, deleted-zh, deleted,
    nothing-learned, forgotten, exported, imported, redeployed, not-a-backup, pinyin-letters-only,
    reading-hiragana-only, failed, sync-deleted, sync-delete-failed,
}

// What sync's switch says under it, as the phone's (ChineseSync.Status).
export enum SyncStatus { off, not-yet, syncing, synced, offline, login-failed }

export global State {
    in property <string> version;
    in property <string> system;          // "Linux" or "Windows"
    in property <string> ui-font;
    in property <bool> zh-available: true;   // the engine's config folder exists
    in property <bool> ja-available: true;
    in property <bool> langs-ready;          // the language list has been read

    in-out property <[Lang]> langs;
    in property <int> langs-on;              // how many are on (one must stay on)
    in property <string> fuzzy-summary;      // the ones that are on, or "" for none
    in-out property <int> zh-script;          // 0 简体, 1 繁體
    in-out property <bool> zh-full-punct: true;
    in-out property <bool> zh-emoji: true;
    in-out property <[Fuzzy]> fuzzy;
    in-out property <[ZhWord]> zh-words;
    in-out property <bool> ja-half-space;
    in-out property <[JaWord]> ja-words;
    // mozc::POS's order
    out property <[string]> ja-pos: [@tr("Noun"), @tr("Proper noun"), @tr("Person"), @tr("Place"), @tr("Organization"), @tr("Emoticon")];

    in-out property <int> page-size: 5;
    in-out property <bool> vertical;
    in-out property <int> font-size: 14;
    in-out property <bool> picnic: true;
    in-out property <bool> learn: true;

    // Sync with the user's own server (#180)
    in-out property <bool> sync-on;
    in property <SyncStatus> sync-status;
    in property <string> sync-at;            // when the last sync went through, for synced
    in property <string> sync-server;        // the saved login, "" before the first
    in property <string> sync-user;

    // What the last change did, shown for a moment (main.rs's toast); app.slint words it.
    in-out property <Msg> toast;
    in property <string> toast-arg;          // the file for exported, the error for failed
    out property <string> backup-file: @tr("SebType settings") + ".json";

    callback set-lang(int, bool);
    callback move-lang(int, int);
    callback zh-changed();
    callback fuzzy-changed(int, bool);
    callback add-zh-word(string, string) -> bool;
    callback remove-zh-word(int);
    callback ja-changed();
    callback add-ja-word(string, string, int) -> bool;
    callback remove-ja-word(int);
    callback candidates-changed();
    callback theme-changed();
    callback learn-changed();
    callback forget(string);   // "zh" or "ja"
    callback export-settings();
    callback import-settings();
    callback redeploy();
    callback sync-toggled(bool);
    callback save-login(string, string, string) -> bool;   // server, user, password; false: not an https address
    callback delete-on-server();
    callback open-help();
}
