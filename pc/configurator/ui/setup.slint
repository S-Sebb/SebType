// SebType's setup wizard (#435): Picnic-themed 5-step installer window (Welcome -> Installing -> Common
// settings (#444) -> Account Sync -> Ready/Tips), launched by Linux's self-extracting installer. Windows
// Setup copies the files itself and opens it at Common settings (#471).
import { Theme } from "theme.slint";
import { Switch, Segmented, PixelFrame, Card, Row, Divider, PageTitle, Button, Kbd, Field, Chrome, MoveArea, WindowControls, WindowEdge, StatusMark } from "widgets.slint";
import { SyncCheck, SyncText } from "state.slint";

// One of the last page's checks (#445). kind: 0 SebType's input method runs where apps reach it (Linux),
// 1 the session started with what setup set (Linux), 2 a global IM module in `file` at `line` (Linux; `own`:
// the person's file, which the button changes), 3 SebType's text service in Windows' language list, 4 Fcitx5
// groups (`text`, `line` of them) with Rime, which won't type Chinese beside SebType (Linux, #542).
export struct ReadyCheck { kind: int, ok: bool, own: bool, file: string, line: int, text: string }

export global SetupState {
    in property <string> ui-font;
    in property <int> first-step;            // 2 after Windows Setup, which welcomes and installs itself
    in property <bool> show-langs: true;     // Windows Setup has its own languages page
    in-out property <int> step;              // 0 Welcome, 1 Installing, 2 Common settings, 3 Account Sync, 4 Ready
    in-out property <int> install-phase;     // 0 packages (pkexec), 1 user setup, 2 failed
    in-out property <string> install-error;
    // The last page's checks, done or with a button that does what is left; asked again while it shows.
    in property <[ReadyCheck]> ready-checks;
    in property <bool> ready;
    in property <int> fixing: -1;            // the check whose button runs
    in property <string> ready-error;
    in-out property <bool> sync-busy;
    in-out property <string> sync-error;
    // Sign in checks the address and login first (#452); after a failure it saves anyway.
    in-out property <SyncCheck> sync-check;
    in-out property <bool> open-configurator: true;
    // Common settings, as the Configurator's Languages, Keyboard and Theme pages have them.
    in-out property <bool> lang-en: true;
    in-out property <bool> lang-zh: true;
    in-out property <bool> lang-ja: true;
    in-out property <bool> traditional;
    in-out property <int> page-size: 6;
    in-out property <bool> picnic: true;
    in-out property <bool> vertical;
    in-out property <bool> common-busy;
    in-out property <string> common-error;

    pure callback server-valid(string) -> bool;
    pure callback can-submit(string, string, string) -> bool;
    callback start-install();
    callback save-common();
    callback save-sync(string, string, string);
    callback skip-sync();
    callback finish();
    callback recheck();
    callback fix(int);
}

// A language's switch with its name, which stays the same in every language.
component LangSwitch inherits HorizontalLayout {
    in property <string> name;
    in-out property <bool> checked;
    in property <bool> enabled;
    spacing: 6px;
    VerticalLayout { alignment: center; Switch { checked <=> root.checked; enabled: root.enabled; label: root.name; } }
    Text { text: root.name; color: Theme.ink; font-size: Theme.body-size; vertical-alignment: center; }
}

component CheckRow inherits HorizontalLayout {
    in property <ReadyCheck> check;
    in property <bool> busy;
    callback fix();
    spacing: 10px;
    padding-top: 4px;
    padding-bottom: 4px;
    VerticalLayout { alignment: center; StatusMark { ok: root.check.ok; } }
    Text {
        text: root.check.kind == 0 ? (root.check.ok ? @tr("SebType's input method is on in every app") : @tr("SebType's input method isn't on in every app yet"))
            : root.check.kind == 1 ? (root.check.ok ? @tr("Apps start with SebType's settings") : @tr("Log out and back in once, so apps like Steam and WINE type with SebType too"))
            : root.check.kind == 2 ? (root.check.ok ? @tr("Turned off: {}", root.check.text) : @tr("“{0}” in {1} (line {2}) keeps apps from using SebType", root.check.text, root.check.file, root.check.line))
            : root.check.kind == 3 ? (root.check.ok ? @tr("SebType is in Windows' input methods") : @tr("SebType is missing from Windows' input methods for 中文 or 日本語"))
            : root.check.ok ? @tr("SebType types Chinese where Rime was")
            : root.check.line == 0 ? @tr("SebType couldn't read Fcitx5's input method groups to check them for Rime: {}", root.check.text)
            : root.check.line == 1 ? @tr("Rime in input method group {} won't type Chinese while SebType is installed. Type Chinese with SebType's 中文", root.check.text)
            : @tr("Rime in input method groups {} won't type Chinese while SebType is installed. Type Chinese with SebType's 中文", root.check.text);
        color: Theme.ink;
        font-size: Theme.body-size;
        vertical-alignment: center;
        horizontal-stretch: 1;
        wrap: word-wrap;
    }
    // Groups Fcitx5 couldn't read have no button: the page reads them again every two seconds.
    if !root.check.ok && !(root.check.kind == 4 && root.check.line == 0): VerticalLayout {
        alignment: center;
        Button {
            text: root.busy ? "…"
                : root.check.kind == 0 ? @tr("Turn on")
                : root.check.kind == 1 ? @tr("Log out")
                : root.check.kind == 2 ? (root.check.own ? @tr("Turn off") : @tr("Open file"))
                : root.check.kind == 3 ? @tr("Add")
                : @tr("Use SebType");
            primary: true;
            enabled: !root.busy;
            min-width: 96px;
            clicked => { root.fix(); }
        }
    }
}

component TipRow inherits HorizontalLayout {
    in property <string> key;
    in property <string> text;
    spacing: 12px;
    padding-top: 4px;
    padding-bottom: 4px;
    alignment: start;
    Kbd { text: root.key; min-width: 108px; }
    Text {
        text: root.text;
        color: Theme.ink;
        font-size: Theme.body-size;
        vertical-alignment: center;
        horizontal-stretch: 1;
        wrap: word-wrap;
    }
}

export component SetupWindow inherits Window {
    title: @tr("SebType Setup");
    icon: @image-url("../../../android/app/src/main/res/mipmap-xxxhdpi/ic_launcher_round.png");
    preferred-width: 580px;
    preferred-height: 560px;  // the sync page with its status and a two-line error (#471)
    min-width: 520px;
    min-height: 500px;
    background: Theme.page;
    default-font-family: SetupState.ui-font;
    default-font-size: 14px;
    no-frame: Chrome.frameless;
    resize-border-width: Chrome.frameless ? 6px : 0;
    maximized <=> Chrome.maximized;

    property <string> sync-server;
    property <string> sync-user;
    property <string> sync-password;
    changed sync-server => { SetupState.sync-check = SyncCheck.none; }
    changed sync-user => { SetupState.sync-check = SyncCheck.none; }
    changed sync-password => { SetupState.sync-check = SyncCheck.none; }

    // The Theme choice shows as the person picks it (#471): Picnic, or a plain system-looking wizard.
    property <bool> plain: !SetupState.picnic;
    init => { Theme.plain = self.plain; }
    changed plain => { Theme.plain = self.plain; }

    // Picnic checkered cloth background.
    if !Theme.plain: Image {
        width: 100%;
        height: 100%;
        source: @image-url("cloth.svg");
        horizontal-tiling: repeat;
        vertical-tiling: repeat;
        image-rendering: pixelated;
    }

    VerticalLayout {
        // Cream title bar with pig icon and step indicator; without a frame it moves the window (#439).
        Rectangle {
            height: 58px;
            background: Theme.card;
            MoveArea { }
            HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                spacing: 12px;
                Rectangle {
                    width: 38px;
                    height: 38px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 19px;
                    background: Theme.plain ? transparent : #FFE4EC;
                    clip: true;
                    Image {
                        source: @image-url("../../../android/app/src/main/res/mipmap-xxxhdpi/ic_launcher_round.png");
                        width: 38px;
                        height: 38px;
                    }
                }
                PageTitle {
                    text: "SebType";
                    font-size: 20px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    PixelFrame {
                        fill: Theme.pink;
                        shadow: false;
                        padding-x: 10px;
                        padding-y: 3px;
                        Text {
                            text: @tr("Step {} of {}", SetupState.step - SetupState.first-step + 1, 5 - SetupState.first-step);
                            color: Theme.ink;
                            font-size: 12.5px;
                            font-weight: 700;
                        }
                    }
                }
                if Chrome.frameless: WindowControls {
                    y: (parent.height - Theme.frame - self.height) / 2;
                    height: 30px;
                    minimize => { root.minimized = true; }
                    close => { root.close(); }
                }
            }
            Rectangle {
                y: parent.height - Theme.frame;
                width: parent.width;
                height: Theme.frame;
                background: Theme.outline;
            }
        }

        // Main wizard card.
        VerticalLayout {
            padding: 20px;
            spacing: 14px;
            vertical-stretch: 1;

            // Step 0: Welcome
            if SetupState.step == 0: VerticalLayout {
                spacing: 14px;
                vertical-stretch: 1;
                Card {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 12px;
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 72px;
                                height: 72px;
                                border-radius: 36px;
                                background: #FFE4EC;
                                border-width: 2px;
                                border-color: Theme.outline;
                                clip: true;
                                Image {
                                    source: @image-url("../../../android/app/src/main/res/mipmap-xxxhdpi/ic_launcher_round.png");
                                    width: 72px;
                                    height: 72px;
                                }
                            }
                        }
                        PageTitle {
                            text: @tr("Hi! Let's set up SebType");
                            color: Theme.key;
                            font-size: 24px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: @tr("SebType types Chinese, Japanese and English on this PC, just like on your phone.");
                            color: Theme.ink;
                            font-size: Theme.body-size;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        Divider { }
                        Text {
                            text: @tr("This installs Chinese (Rime with SebType's dictionary), Japanese (SebType's Mozc), and the SebType Configurator.");
                            color: Theme.ink;
                            font-size: 14px;
                            wrap: word-wrap;
                        }
                        Text {
                            text: @tr("Already have SebType? This updates it and keeps every word it has learned.");
                            color: Theme.muted;
                            font-size: Theme.detail-size;
                            wrap: word-wrap;
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    Button {
                        text: @tr("Install");
                        primary: true;
                        min-width: 120px;
                        clicked => { SetupState.start-install(); }
                    }
                }
            }

            // Step 1: Installing
            if SetupState.step == 1: VerticalLayout {
                spacing: 14px;
                vertical-stretch: 1;
                Card {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 24px;
                        spacing: 14px;
                        alignment: center;
                        PageTitle {
                            text: @tr("Setting up SebType");
                            color: Theme.key;
                            font-size: 22px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: SetupState.install-phase == 0 ? @tr("Installing SebType packages…")
                                : SetupState.install-phase == 1 ? @tr("Setting up your account…")
                                : @tr("Installation didn't finish");
                            color: SetupState.install-phase == 2 ? Theme.danger : Theme.ink;
                            font-size: 16px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        if SetupState.install-phase != 2: Text {
                            text: SetupState.install-phase == 0
                                ? @tr("Approve the administrator prompt when asked. The words SebType has learned stay.")
                                : @tr("Configuring Fcitx5, Rime, Mozc, and SebType Configurator…");
                            color: Theme.muted;
                            font-size: Theme.detail-size;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        if SetupState.install-phase != 2: PixelFrame {
                            height: 20px;
                            fill: Theme.off-track;
                            shadow: false;
                            Rectangle {
                                height: 10px;
                                clip: true;
                                Rectangle {
                                    x: 0;
                                    width: SetupState.install-phase == 0 ? parent.width * 0.45 : parent.width * 0.85;
                                    height: parent.height;
                                    background: Theme.key;
                                    animate width { duration: 250ms; }
                                }
                            }
                        }
                        if SetupState.install-phase == 2 && SetupState.install-error != "": PixelFrame {
                            fill: Theme.pink;
                            shadow: false;
                            padding-x: 12px;
                            padding-y: 10px;
                            Text {
                                text: SetupState.install-error;
                                color: Theme.danger;
                                font-size: Theme.detail-size;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    if SetupState.install-phase == 2: Button {
                        text: @tr("Retry");
                        primary: true;
                        min-width: 110px;
                        clicked => { SetupState.start-install(); }
                    }
                }
            }

            // Step 2: Common settings (#444), shown as installed; Next keeps what isn't changed.
            if SetupState.step == 2: VerticalLayout {
                spacing: 14px;
                vertical-stretch: 1;
                // One language always stays on, as on the Languages page.
                property <int> langs-on: (SetupState.lang-en ? 1 : 0) + (SetupState.lang-zh ? 1 : 0) + (SetupState.lang-ja ? 1 : 0);
                Card {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding-top: 14px;
                        padding-bottom: 6px;
                        VerticalLayout {
                            padding-left: Theme.row-padding-x;
                            padding-right: Theme.row-padding-x;
                            padding-bottom: 4px;
                            spacing: 4px;
                            PageTitle {
                                text: @tr("Common settings");
                                color: Theme.key;
                                font-size: 21px;
                            }
                            Text {
                                text: @tr("You can change all of these later in SebType Configurator.");
                                color: Theme.muted;
                                font-size: Theme.detail-size;
                                wrap: word-wrap;
                            }
                        }
                        if SetupState.show-langs: Row {
                            title: @tr("Languages");
                            HorizontalLayout {
                                spacing: 12px;
                                alignment: end;
                                LangSwitch { name: "English"; checked <=> SetupState.lang-en; enabled: !SetupState.lang-en || langs-on > 1; }
                                LangSwitch { name: "中文"; checked <=> SetupState.lang-zh; enabled: !SetupState.lang-zh || langs-on > 1; }
                                LangSwitch { name: "日本語"; checked <=> SetupState.lang-ja; enabled: !SetupState.lang-ja || langs-on > 1; }
                            }
                        }
                        if SetupState.show-langs: Divider { }
                        Row {
                            title: "中文";
                            VerticalLayout { alignment: center;
                                Segmented {
                                    options: ["简体", "繁體"];
                                    current: SetupState.traditional ? 1 : 0;
                                    selected(i) => { SetupState.traditional = i == 1; }
                                }
                            }
                        }
                        Divider { }
                        Row {
                            title: @tr("Theme");
                            VerticalLayout { alignment: center;
                                Segmented {
                                    options: ["Picnic", @tr("System style")];
                                    current: SetupState.picnic ? 0 : 1;
                                    selected(i) => { SetupState.picnic = i == 0; }
                                }
                            }
                        }
                        Divider { }
                        Row {
                            title: @tr("Layout");
                            VerticalLayout { alignment: center;
                                Segmented {
                                    options: [@tr("Horizontal"), @tr("Vertical")];
                                    current: SetupState.vertical ? 1 : 0;
                                    selected(i) => { SetupState.vertical = i == 1; }
                                }
                            }
                        }
                        Divider { }
                        Row {
                            title: @tr("Candidates per page");
                            VerticalLayout { alignment: center;
                                Segmented {
                                    options: ["5", "6", "7", "8", "9"];
                                    current: SetupState.page-size - 5;
                                    selected(i) => { SetupState.page-size = i + 5; }
                                }
                            }
                        }
                        if SetupState.common-error != "": HorizontalLayout {
                            padding-left: Theme.row-padding-x;
                            padding-right: Theme.row-padding-x;
                            Text {
                                text: SetupState.common-error;
                                color: Theme.danger;
                                font-size: Theme.detail-size;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    Button {
                        text: @tr("Next");
                        primary: true;
                        enabled: !SetupState.common-busy;
                        min-width: 110px;
                        clicked => { SetupState.save-common(); }
                    }
                }
            }

            // Step 3: Account Sync (optional)
            if SetupState.step == 3: VerticalLayout {
                spacing: 14px;
                vertical-stretch: 1;
                Card {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 8px;
                        PageTitle {
                            text: @tr("Account sync");
                            color: Theme.key;
                            font-size: 21px;
                        }
                        Text {
                            text: @tr("Sync your learned words and dictionaries across devices with your own sync server. You can also set this up later in SebType Configurator.");
                            color: Theme.muted;
                            font-size: Theme.detail-size;
                            wrap: word-wrap;
                        }
                        Text { text: @tr("Server address"); color: Theme.ink; font-size: Theme.body-size; }
                        Field { text <=> root.sync-server; placeholder: "sync.example.com"; accessible-label: @tr("Server address"); }
                        if root.sync-server != "" && !SetupState.server-valid(root.sync-server): Text {
                            text: @tr("An https:// address");
                            color: Theme.danger;
                            font-size: Theme.detail-size;
                        }
                        Text { text: @tr("Username"); color: Theme.ink; font-size: Theme.body-size; }
                        Field { text <=> root.sync-user; accessible-label: @tr("Username"); }
                        Text { text: @tr("Password"); color: Theme.ink; font-size: Theme.body-size; }
                        Field {
                            text <=> root.sync-password;
                            input-type: InputType.password;
                            accessible-label: @tr("Password");
                            accepted => {
                                if !SetupState.sync-busy && SetupState.can-submit(root.sync-server, root.sync-user, root.sync-password) {
                                    SetupState.save-sync(root.sync-server, root.sync-user, root.sync-password);
                                }
                            }
                        }
                        if SetupState.sync-check != SyncCheck.none: HorizontalLayout {
                            spacing: 6px;
                            if SetupState.sync-check == SyncCheck.connected || SyncText.failed(SetupState.sync-check): StatusMark {
                                ok: SetupState.sync-check == SyncCheck.connected;
                            }
                            Text {
                                text: SyncText.check(SetupState.sync-check);
                                color: SyncText.failed(SetupState.sync-check) ? Theme.danger : Theme.muted;
                                font-size: Theme.detail-size;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }
                        }
                        if SetupState.sync-error != "": Text {
                            text: SetupState.sync-error;
                            color: Theme.danger;
                            font-size: Theme.detail-size;
                            wrap: word-wrap;
                        }
                    }
                }
                HorizontalLayout {
                    alignment: space-between;
                    Button {
                        text: @tr("Skip");
                        enabled: !SetupState.sync-busy;
                        min-width: 96px;
                        clicked => {
                            root.sync-password = "";
                            SetupState.skip-sync();
                        }
                    }
                    Button {
                        text: SyncText.failed(SetupState.sync-check) ? @tr("Save anyway & continue") : @tr("Sign in & continue");
                        primary: true;
                        enabled: !SetupState.sync-busy && SetupState.can-submit(root.sync-server, root.sync-user, root.sync-password);
                        clicked => {
                            SetupState.save-sync(root.sync-server, root.sync-user, root.sync-password);
                        }
                    }
                }
            }

            // Step 4: Ready / Tips
            if SetupState.step == 4: VerticalLayout {
                spacing: 12px;
                vertical-stretch: 1;
                Card {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 18px;
                        spacing: 6px;
                        alignment: start;
                        PageTitle {
                            text: SetupState.ready ? @tr("SebType is ready!") : SetupState.ready-checks.length == 0 ? @tr("Checking…") : @tr("Almost ready");
                            color: Theme.key;
                            font-size: 22px;
                        }
                        if !SetupState.ready && SetupState.ready-checks.length > 0: Text {
                            text: @tr("Still to do, so SebType types in every app:");
                            color: Theme.muted;
                            font-size: Theme.detail-size;
                            wrap: word-wrap;
                        }
                        for check[i] in SetupState.ready-checks: CheckRow {
                            check: check;
                            busy: SetupState.fixing == i;
                            fix => { SetupState.fix(i); }
                        }
                        if SetupState.ready-error != "": Text {
                            text: SetupState.ready-error;
                            color: Theme.danger;
                            font-size: Theme.detail-size;
                            wrap: word-wrap;
                        }
                    }
                }
                // The keys once there is nothing left to do: until then the steps have the room.
                if SetupState.ready: Card {
                    VerticalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        spacing: 2px;
                        TipRow { key: "Win+Space"; text: @tr("Switch EN → 中 → あ"); }
                        TipRow { key: "Shift"; text: @tr("Tap for quick English in 中文 or 日本語"); }
                        TipRow { key: "Ctrl+Shift+F"; text: @tr("Switch 简 ↔ 繁"); }
                        TipRow { key: "Alt+`"; text: @tr("Switch あ ↔ ア"); }
                    }
                }
                HorizontalLayout {
                    alignment: space-between;
                    padding-top: 4px;
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            Switch {
                                checked <=> SetupState.open-configurator;
                                label: @tr("Open SebType Configurator");
                            }
                        }
                        Text {
                            text: @tr("Open SebType Configurator");
                            color: Theme.ink;
                            font-size: Theme.body-size;
                            vertical-alignment: center;
                        }
                    }
                    Button {
                        text: @tr("Finish");
                        primary: true;
                        min-width: 110px;
                        clicked => { SetupState.finish(); }
                    }
                }
            }
        }
    }

    // The last page checks again every few seconds, so a step done elsewhere ticks by itself.
    property <int> step: SetupState.step;
    changed step => { if step == 4 { SetupState.recheck(); } }
    Timer { interval: 2s; running: SetupState.step == 4 && SetupState.fixing < 0; triggered => { SetupState.recheck(); } }

    // As AppWindow's: Wayland never says the window came back from the task bar.
    Timer { interval: 500ms; running: Chrome.frameless && root.minimized; triggered => { root.minimized = false; } }
    WindowEdge { }
}
