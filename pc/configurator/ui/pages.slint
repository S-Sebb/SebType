import { ScrollView, AboutSlint } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { State, SyncStatus } from "state.slint";
import { Switch, Segmented, PixelFrame, Card, Row, Divider, SectionTag, PageTitle, Info, Button, Kbd, Field, TitleBar } from "widgets.slint";

// Which group (page) and which screen inside it is shown, and the question waiting for an answer.
export global Nav {
    in-out property <int> page;       // 0 Languages … 5 About
    in-out property <int> sub;        // 0 the group; 1 Fuzzy pinyin or Server and login, 2 中文 My words, 3 日本語 My words
    in-out property <string> confirm-lang;  // "zh" or "ja" while Forget waits for a yes
    in-out property <bool> confirm-delete;  // while Delete on the server waits for a yes
}

// A page: its title bar, and its items scrolling on the cloth under it.
component Page inherits VerticalLayout {
    in property <string> title;
    in property <bool> back;
    TitleBar { text: root.title; back: root.back; go-back => { Nav.sub = 0; } }
    scroll := ScrollView {
        vertical-stretch: 1;
        content-width: self.visible-width;
        VerticalLayout {
            width: scroll.visible-width;
            padding: Theme.page-padding;
            spacing: Theme.card-gap;
            alignment: start;
            @children
        }
    }
}

component LanguagesPage inherits Page {
    title: @tr("Languages");
    property <length> lang-row: 58px;
    property <int> dragging: -1;
    property <int> target: -1;
    // The input method names, the same in every language (Decisions #2, #92).
    pure function name(id: string) -> string { return id == "zh" ? "中文" : id == "ja" ? "日本語" : "English"; }
    pure function detail(id: string) -> string {
        return id == "zh" ? @tr("rime-ice pinyin · rime-frost dictionary") : id == "ja" ? @tr("Mozc romaji") : @tr("The US keyboard");
    }

    // Linux: Win+Space is Fcitx5's trigger key, English ⇄ the last other language (#93).
    Info { text: State.system == "Windows" ? @tr("Win+Space switches between the languages that are on, in this order. Drag ≡ to reorder.")
        : @tr("Win+Space switches between the first language and the other one you used last; pick the others from the tray menu. Drag ≡ to reorder."); }
    Card {
        for l[i] in State.langs: Rectangle {
            height: root.lang-row;
            background: i == root.dragging ? Theme.pink : transparent;
            if i > 0: Divider { y: 0; width: parent.width; }
            // Where the dragged language will land.
            if root.dragging >= 0 && i == root.target && i != root.dragging: Rectangle {
                y: root.target < root.dragging ? 0 : parent.height - 3px;
                height: 3px;
                background: Theme.key;
            }
            HorizontalLayout {
                padding-left: 6px;
                padding-right: Theme.row-padding-x;
                spacing: 8px;
                Rectangle {
                    width: 34px;
                    accessible-role: button;
                    accessible-label: @tr("Move {}", root.name(l.id));
                    accessible-description: @tr("Move up");
                    accessible-action-default => { if i > 0 { State.move-lang(i, i - 1); } }
                    Text { text: "≡"; color: Theme.muted; font-size: 20px; }
                    TouchArea {
                        mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.down { root.dragging = i; root.target = i; }
                            if e.kind == PointerEventKind.up {
                                if root.dragging >= 0 && root.target != root.dragging { State.move-lang(root.dragging, root.target); }
                                root.dragging = -1; root.target = -1;
                            }
                        }
                        moved => {
                            root.target = max(0, min(State.langs.length - 1, i + round((self.mouse-y - self.pressed-y) / root.lang-row)));
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text { text: root.name(l.id); color: Theme.ink; font-size: Theme.body-size; }
                    Text { text: root.detail(l.id); color: Theme.muted; font-size: Theme.detail-size; }
                }
                VerticalLayout {
                    alignment: center;
                    Switch {
                        checked: l.on;
                        label: root.name(l.id);
                        // One language stays on.
                        enabled: State.langs-ready && !(l.on && State.langs-on <= 1);
                        toggled(on) => { State.set-lang(i, on); }
                    }
                }
            }
        }
    }

    SectionTag { text: "中文"; }
    Card {
        Row {
            title: @tr("Default characters");
            detail: @tr("Ctrl+Shift+F switches at any time");
            enabled: State.zh-available;
            VerticalLayout { alignment: center;
                Segmented {
                    options: ["简体", "繁體"];
                    current <=> State.zh-script;
                    enabled: State.zh-available;
                    selected => { State.zh-changed(); }
                }
            }
        }
        Divider { }
        Row {
            title: @tr("Full-width punctuation");
            detail: @tr("，。？ instead of , . ?");
            enabled: State.zh-available;
            VerticalLayout { alignment: center;
                Switch { checked <=> State.zh-full-punct; label: @tr("Full-width punctuation"); enabled: State.zh-available; toggled => { State.zh-changed(); } }
            }
        }
        Divider { }
        Row {
            title: @tr("Emoji in candidates");
            detail: @tr("An emoji next to words that have one");
            enabled: State.zh-available;
            VerticalLayout { alignment: center;
                Switch { checked <=> State.zh-emoji; label: @tr("Emoji in candidates"); enabled: State.zh-available; toggled => { State.zh-changed(); } }
            }
        }
        Divider { }
        Row {
            title: @tr("Fuzzy pinyin");
            detail: State.fuzzy-summary == "" ? @tr("Off") : State.fuzzy-summary;
            arrow: true;
            enabled: State.zh-available;
            clicked => { Nav.sub = 1; }
        }
        Divider { }
        Row {
            title: @tr("My words");
            detail: @tr("Your own words, first when you type their pinyin");
            arrow: true;
            enabled: State.zh-available;
            clicked => { Nav.sub = 2; }
        }
    }
    SectionTag { text: "日本語"; }
    Card {
        Row {
            title: @tr("Half-width space");
            detail: State.ja-available ? @tr("Space always types a half-width space") : @tr("Mozc not found");
            enabled: State.ja-available;
            VerticalLayout { alignment: center;
                Switch { checked <=> State.ja-half-space; label: @tr("Half-width space"); enabled: State.ja-available; toggled => { State.ja-changed(); } }
            }
        }
        Divider { }
        Row {
            title: @tr("My words");
            detail: @tr("Mozc's user dictionary");
            arrow: true;
            enabled: State.ja-available;
            clicked => { Nav.sub = 3; }
        }
    }

    SectionTag { text: "English"; }
    Card {
        Row { title: @tr("The system's US keyboard"); detail: @tr("English on the PC is the plain keyboard, without SebType's extras"); }
    }
}

component FuzzyPage inherits Page {
    title: @tr("Fuzzy pinyin");
    back: true;
    Info { text: @tr("Sounds that are easy to mix up count as one, so zi also gives 知."); }
    Card {
        for f[i] in State.fuzzy: Row {
            title: f.label;
            line-above: i > 0;
            VerticalLayout { alignment: center;
                Switch { checked: f.on; label: f.label; toggled(on) => { State.fuzzy-changed(i, on); } }
            }
        }
    }
}

component ZhWordsPage inherits Page {
    title: @tr("My words") + " · 中文";
    back: true;
    property <string> word;
    property <string> code;
    Info { text: @tr("Your own words, such as names. They come first when you type their pinyin."); }
    Card {
        HorizontalLayout {
            padding: Theme.row-padding-x;
            spacing: 10px;
            Field { text <=> root.word; placeholder: @tr("Word, e.g. {}", "小明"); horizontal-stretch: 1; }
            Field { text <=> root.code; placeholder: @tr("Pinyin, e.g. {}", "xiaoming"); horizontal-stretch: 1; accepted => { add.clicked(); } }
            add := Button {
                text: @tr("Add");
                primary: true;
                enabled: root.word != "" && root.code != "";
                clicked => { if State.add-zh-word(root.word, root.code) { root.word = ""; root.code = ""; } }
            }
        }
    }
    if State.zh-words.length > 0: Card {
        for w[i] in State.zh-words: Row {
            title: w.word;
            line-above: i > 0;
            detail: w.code;
            VerticalLayout { alignment: center;
                Button { text: @tr("Delete"); clicked => { State.remove-zh-word(i); } }
            }
        }
    }
}

component JaWordsPage inherits Page {
    title: @tr("My words") + " · 日本語";
    back: true;
    property <string> reading;
    property <string> word;
    property <int> pos;
    Info { text: @tr("Mozc's user dictionary. Readings are in hiragana, e.g. {}.", "せぶ → SebType"); }
    Card {
        VerticalLayout {
            padding: Theme.row-padding-x;
            spacing: 10px;
            HorizontalLayout {
                spacing: 10px;
                Field { text <=> root.reading; placeholder: @tr("Reading (hiragana)"); horizontal-stretch: 1; }
                Field { text <=> root.word; placeholder: @tr("Word"); horizontal-stretch: 1; accepted => { add.clicked(); } }
                add := Button {
                    text: @tr("Add");
                    primary: true;
                    enabled: root.reading != "" && root.word != "";
                    clicked => { if State.add-ja-word(root.reading, root.word, root.pos) { root.reading = ""; root.word = ""; } }
                }
            }
            HorizontalLayout {
                alignment: start;
                Segmented { options: State.ja-pos; current <=> root.pos; }
            }
        }
    }
    if State.ja-words.length > 0: Card {
        for w[i] in State.ja-words: Row {
            title: w.word;
            line-above: i > 0;
            detail: w.reading + " · " + State.ja-pos[w.pos];
            VerticalLayout { alignment: center;
                Button { text: @tr("Delete"); clicked => { State.remove-ja-word(i); } }
            }
        }
    }
}

// The candidate window as it will look, redrawn as the settings change.
component CandidateSample inherits Rectangle {
    in property <bool> picnic: State.picnic;
    in property <bool> vertical: State.vertical;
    in property <int> count: State.page-size;
    property <[string]> words: ["你好", "拟好", "你", "呢", "👋", "泥", "尼", "妮", "倪"];
    property <length> size: State.font-size * 1px;
    background: picnic ? Theme.card : #ffffff;
    border-radius: picnic ? 10px : 2px;
    border-width: 2px;
    border-color: picnic ? Theme.outline : #c0c0c0;
    width: self.preferred-width;
    height: self.preferred-height;
    VerticalLayout {
        padding: 6px;
        spacing: 4px;
        Text { text: "ni hao"; color: picnic ? Theme.muted : #555555; font-size: root.size * 0.85; }
        if !root.vertical: HorizontalLayout {
            spacing: 6px;
            for w[i] in root.words: Rectangle {
                visible: i < root.count;
                width: i < root.count ? self.preferred-width : 0;
                background: i == 0 ? (root.picnic ? Theme.key : #808080) : transparent;
                border-radius: root.picnic ? 6px : 0;
                HorizontalLayout {
                    padding-left: 5px;
                    padding-right: 5px;
                    Text { text: (i + 1) + " " + w; color: i == 0 ? white : (root.picnic ? Theme.ink : black); font-size: root.size; }
                }
            }
        }
        if root.vertical: VerticalLayout {
            for w[i] in root.words: Rectangle {
                visible: i < root.count;
                height: i < root.count ? self.preferred-height : 0;
                background: i == 0 ? (root.picnic ? Theme.key : #808080) : transparent;
                border-radius: root.picnic ? 6px : 0;
                HorizontalLayout {
                    padding-left: 5px;
                    padding-right: 5px;
                    Text { text: (i + 1) + " " + w; color: i == 0 ? white : (root.picnic ? Theme.ink : black); font-size: root.size; }
                }
            }
        }
    }
}

component KeyboardPage inherits Page {
    title: @tr("Keyboard");
    SectionTag { text: @tr("Candidate window"); }
    Card {
        HorizontalLayout {
            padding: Theme.row-padding-x;
            height: State.vertical ? 300px : 80px;
            alignment: start;
            VerticalLayout { alignment: start; CandidateSample { } }
        }
        Divider { }
        Row {
            title: @tr("Candidates per page");
            detail: @tr("中文 (日本語 always shows 9)");
            VerticalLayout { alignment: center;
                Segmented {
                    options: ["5", "6", "7", "8", "9"];
                    current: State.page-size - 5;
                    selected(i) => { State.page-size = i + 5; State.candidates-changed(); }
                }
            }
        }
        Divider { }
        Row {
            title: @tr("Layout");
            VerticalLayout { alignment: center;
                Segmented {
                    options: [@tr("Horizontal"), @tr("Vertical")];
                    current: State.vertical ? 1 : 0;
                    selected(i) => { State.vertical = i == 1; State.candidates-changed(); }
                }
            }
        }
        Divider { }
        Row {
            title: @tr("Font size");
            detail: State.font-size;
            HorizontalLayout { alignment: center; spacing: 8px;
                Button { text: "A−"; enabled: State.font-size > 9; clicked => { State.font-size -= 1; State.candidates-changed(); } }
                Button { text: "A+"; enabled: State.font-size < 24; clicked => { State.font-size += 1; State.candidates-changed(); } }
            }
        }
    }
    SectionTag { text: @tr("Shortcuts"); }
    Card {
        Row { title: State.system == "Windows" ? @tr("Switch language: EN → 中 → 日") : @tr("Switch language: EN ⇄ the last 中 or 日"); VerticalLayout { alignment: center; Kbd { text: "Win+Space"; } } }
        Divider { }
        // The names of the two switches are the menus' (#117).
        Row { title: @tr("English letters in 中文 or 日本語"); detail: @tr("Tap Shift on its own"); VerticalLayout { alignment: center; Kbd { text: "Shift"; } } }
        Divider { }
        Row { title: "日本語 あ ⇄ ア"; VerticalLayout { alignment: center; Kbd { text: "Alt+`"; } } }
        Divider { }
        Row { title: "中文 简 ⇄ 繁"; VerticalLayout { alignment: center; Kbd { text: "Ctrl+Shift+F"; } } }
    }
}

component ThemeChoice inherits PixelFrame {
    in property <string> title;
    in property <bool> picnic;
    in property <bool> selected;
    callback clicked;
    fill: selected ? Theme.pink : Theme.card;
    accessible-role: button;
    accessible-label: title;
    accessible-checked: selected;
    accessible-action-default => { clicked(); }
    Rectangle {
        VerticalLayout {
            padding: 12px;
            spacing: 10px;
            alignment: start;
            HorizontalLayout { alignment: center; CandidateSample { picnic: root.picnic; vertical: false; count: 4; } }
            Text { text: (root.selected ? "● " : "○ ") + root.title; color: Theme.ink; font-size: Theme.body-size; horizontal-alignment: center; }
        }
        TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    }
}

component ThemePage inherits Page {
    title: @tr("Theme");
    SectionTag { text: @tr("Candidate window"); }
    HorizontalLayout {
        spacing: Theme.card-gap;
        ThemeChoice { title: "Picnic"; picnic: true; selected: State.picnic;
            clicked => { if !State.picnic { State.picnic = true; State.theme-changed(); } } }
        ThemeChoice { title: @tr("System style"); picnic: false; selected: !State.picnic;
            clicked => { if State.picnic { State.picnic = false; State.theme-changed(); } } }
    }
    Text {
        text: State.system == "Windows" ? @tr("日本語's candidate window is drawn by Mozc itself and stays as it is.")
            : @tr("The candidate windows of 中文 and 日本語 both use this style.");
        color: Theme.muted;
        font-size: Theme.detail-size;
        wrap: word-wrap;
    }
}

component PrivacyPage inherits Page {
    title: @tr("Privacy");
    Card {
        Row {
            title: @tr("Learn from my typing");
            detail: @tr("中文 and 日本語 remember the words you pick and put them first next time");
            VerticalLayout { alignment: center;
                Switch { checked <=> State.learn; label: @tr("Learn from my typing"); toggled => { State.learn-changed(); } }
            }
        }
    }
    SectionTag { text: @tr("Forget learned words"); }
    Card {
        Row {
            title: "中文";
            detail: @tr("Deletes the words Rime learned; your own words stay");
            enabled: State.zh-available;
            VerticalLayout { alignment: center;
                Button { text: @tr("Forget…"); enabled: State.zh-available; clicked => { Nav.confirm-lang = "zh"; } }
            }
        }
        Divider { }
        Row {
            title: "日本語";
            detail: @tr("Deletes Mozc's typing history; the user dictionary stays");
            enabled: State.ja-available;
            VerticalLayout { alignment: center;
                Button { text: @tr("Forget…"); enabled: State.ja-available; clicked => { Nav.confirm-lang = "ja"; } }
            }
        }
    }
    Text {
        text: @tr("Clipboard history comes from the system ({}), not from here.", State.system == "Windows" ? "Win+V" : "Klipper");
        color: Theme.muted;
        font-size: Theme.detail-size;
        wrap: word-wrap;
    }
}

// Sync's wording is the phone's sync screen's (#14).
component SyncPage inherits Page {
    title: @tr("Sync & backup");
    SectionTag { text: @tr("Sync"); }
    Card {
        Row {
            title: @tr("Sync learned words and dictionaries");
            detail: State.sync-status == SyncStatus.off ? @tr("中文's learned words and your Japanese and English dictionaries, with your own server")
                : State.sync-status == SyncStatus.not-yet ? @tr("Not synced yet")
                : State.sync-status == SyncStatus.syncing ? @tr("Syncing…")
                : State.sync-status == SyncStatus.synced ? @tr("Last synced {}", State.sync-at)
                : State.sync-status == SyncStatus.offline ? @tr("Can't reach the server. Syncs once it can")
                : @tr("Wrong username or password");
            VerticalLayout { alignment: center;
                Switch {
                    checked <=> State.sync-on;
                    label: @tr("Sync learned words and dictionaries");
                    // Without a login, the switch asks for one first.
                    toggled(on) => { if State.sync-user == "" { self.checked = false; Nav.sub = 1; } else { State.sync-toggled(on); } }
                }
            }
        }
        Divider { }
        Row {
            title: @tr("Server and login");
            detail: State.sync-user == "" ? @tr("Not set") : State.sync-user + " · " + State.sync-server;
            arrow: true;
            clicked => { Nav.sub = 1; }
        }
        if State.sync-user != "": Row {
            title: @tr("Delete learned words and dictionaries on the server");
            detail: @tr("The learned words and dictionaries on your devices stay");
            line-above: true;
            VerticalLayout { alignment: center; Button { text: @tr("Delete…"); danger: true; clicked => { Nav.confirm-delete = true; } } }
        }
    }
    SectionTag { text: @tr("Backup"); }
    Card {
        Row {
            title: @tr("Export settings");
            detail: @tr("Every setting and your own words, in one file");
            VerticalLayout { alignment: center; Button { text: @tr("Export…"); clicked => { State.export-settings(); } } }
        }
        Divider { }
        Row {
            title: @tr("Import settings");
            detail: @tr("Restore from an exported file");
            VerticalLayout { alignment: center; Button { text: @tr("Import…"); clicked => { State.import-settings(); } } }
        }
    }
}

component SyncLoginPage inherits Page {
    title: @tr("Server and login");
    back: true;
    property <string> server: State.sync-server;
    property <string> user: State.sync-user;
    property <string> password;
    property <bool> invalid;
    Card {
        VerticalLayout {
            padding: Theme.row-padding-x;
            spacing: 6px;
            Text { text: @tr("Server address"); color: Theme.ink; font-size: Theme.body-size; }
            Field { text <=> root.server; placeholder: "sync.example.com"; }
            if root.invalid: Text { text: @tr("An https:// address"); color: Theme.danger; font-size: Theme.detail-size; }
            Text { text: @tr("Username"); color: Theme.ink; font-size: Theme.body-size; }
            Field { text <=> root.user; }
            Text { text: @tr("Password"); color: Theme.ink; font-size: Theme.body-size; }
            Field { text <=> root.password; input-type: InputType.password; accepted => { save.clicked(); } }
            HorizontalLayout {
                alignment: end;
                spacing: 10px;
                padding-top: 6px;
                Button { text: @tr("Cancel"); clicked => { Nav.sub = 0; } }
                save := Button {
                    text: @tr("Save");
                    primary: true;
                    enabled: root.server != "" && root.user != "" && root.password != "";
                    clicked => {
                        if !self.enabled { return; }
                        if State.save-login(root.server, root.user, root.password) { root.password = ""; Nav.sub = 0; } else { root.invalid = true; }
                    }
                }
            }
        }
    }
}

component AboutPage inherits Page {
    title: @tr("About");
    Card {
        HorizontalLayout {
            padding: Theme.row-padding-x;
            spacing: 14px;
            alignment: start;
            Rectangle {
                width: 64px; height: 64px; border-radius: 32px; background: #FFE4EC; clip: true;
                Image { source: @image-url("../../../sebtype/res-stable/mipmap-xxxhdpi/ic_launcher_round.png"); width: 64px; height: 64px; }
            }
            VerticalLayout { alignment: center;
                PageTitle { text: @tr("SebType Configurator"); font-size: 18px; }
                Text { text: @tr("Version {} · {}", State.version, State.system); color: Theme.muted; font-size: Theme.detail-size; }
            }
        }
    }
    Card {
        Row { title: @tr("Help and feedback"); detail: @tr("SebType's issues on GitHub"); arrow: true; clicked => { State.open-help(); } }
    }
    SectionTag { text: @tr("Licence and credits"); }
    Card {
        Row { title: "雾凇拼音 rime-ice · 白霜拼音 rime-frost"; detail: "GPL-3.0"; }
        Divider { }
        Row { title: "Rime (librime)" + (State.system == "Windows" ? " · 小狼毫 Weasel" : " · Fcitx5 · fcitx5-rime"); detail: State.system == "Windows" ? "BSD-3-Clause · GPL-3.0" : "BSD-3-Clause · LGPL-2.1+"; }
        Divider { }
        Row { title: "Mozc"; detail: "BSD-3-Clause"; }
        Divider { }
        Row { title: "Nunito"; detail: "SIL Open Font License 1.1"; }
        HorizontalLayout { padding: Theme.row-padding-x; alignment: start; AboutSlint { } }
    }
}

export component Pages inherits Rectangle {
    // The keyboard's cloth behind every page, as behind the phone's settings.
    Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("cloth.svg");
        horizontal-tiling: repeat;
        vertical-tiling: repeat;
        image-rendering: pixelated;
    }
    if Nav.page == 0 && Nav.sub == 0: LanguagesPage { }
    if Nav.page == 0 && Nav.sub == 1: FuzzyPage { }
    if Nav.page == 0 && Nav.sub == 2: ZhWordsPage { }
    if Nav.page == 0 && Nav.sub == 3: JaWordsPage { }
    if Nav.page == 1: KeyboardPage { }
    if Nav.page == 2: ThemePage { }
    if Nav.page == 3: PrivacyPage { }
    if Nav.page == 4 && Nav.sub == 0: SyncPage { }
    if Nav.page == 4 && Nav.sub == 1: SyncLoginPage { }
    if Nav.page == 5: AboutPage { }
}
