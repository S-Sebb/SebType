import { ScrollView, AboutSlint } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { State } from "state.slint";
import { Switch, Segmented, Card, Row, Divider, SectionTitle, PageTitle, Info, Button, Kbd, Field, BackTitle } from "widgets.slint";

// Which group (page) and which screen inside it is shown, and the question waiting for an answer.
export global Nav {
    in-out property <int> page;       // 0 语言 … 5 关于
    in-out property <int> sub;        // 0 the group; 1 模糊拼音, 2 中文 我的词语, 3 日本語 我的词语
    in-out property <string> confirm-lang;  // "zh" or "ja" while 忘记 waits for a yes
}

component Page inherits ScrollView {
    in property <string> title;
    in property <bool> back;
    content-width: self.visible-width;
    VerticalLayout {
        width: root.visible-width;
        padding: Theme.page-padding;
        spacing: Theme.card-gap;
        alignment: start;
        if !root.back: PageTitle { text: root.title; }
        if root.back: BackTitle { text: root.title; back => { Nav.sub = 0; } }
        @children
    }
}

component LanguagesPage inherits Page {
    title: "语言";
    property <length> lang-row: 58px;
    property <int> dragging: -1;
    property <int> target: -1;

    // Linux: Win+Space is Fcitx5's trigger key, English ⇄ the last other language (#93).
    Info { text: State.system == "Windows" ? "按 Win+Space 在已开启的语言之间按此顺序切换。拖动 ≡ 可调整顺序。"
        : "按 Win+Space 在第一个语言和上次用的另一种语言之间切换，其他语言从托盘菜单选。拖动 ≡ 可调整顺序。"; }
    Card {
        for l[i] in State.langs: Rectangle {
            height: root.lang-row;
            background: i == root.dragging ? Theme.pink : transparent;
            border-radius: Theme.card-radius - 2px;
            // Where the dragged language will land.
            if root.dragging >= 0 && i == root.target && i != root.dragging: Rectangle {
                y: root.target < root.dragging ? 0 : parent.height - 3px;
                height: 3px;
                background: Theme.key;
            }
            HorizontalLayout {
                padding-left: 6px;
                padding-right: Theme.row-padding-x;
                spacing: 8px;
                Rectangle {
                    width: 34px;
                    accessible-role: button;
                    accessible-label: "移动 " + l.name;
                    accessible-description: "上移";
                    accessible-action-default => { if i > 0 { State.move-lang(i, i - 1); } }
                    Text { text: "≡"; color: Theme.muted; font-size: 20px; }
                    TouchArea {
                        mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.down { root.dragging = i; root.target = i; }
                            if e.kind == PointerEventKind.up {
                                if root.dragging >= 0 && root.target != root.dragging { State.move-lang(root.dragging, root.target); }
                                root.dragging = -1; root.target = -1;
                            }
                        }
                        moved => {
                            root.target = max(0, min(State.langs.length - 1, i + round((self.mouse-y - self.pressed-y) / root.lang-row)));
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text { text: l.name; color: Theme.ink; font-size: Theme.body-size; }
                    Text { text: l.detail; color: Theme.muted; font-size: Theme.detail-size; }
                }
                VerticalLayout {
                    alignment: center;
                    Switch {
                        checked: l.on;
                        label: l.name;
                        // One language stays on.
                        enabled: State.langs-ready && !(l.on && State.langs-on <= 1);
                        toggled(on) => { State.set-lang(i, on); }
                    }
                }
            }
        }
    }

    SectionTitle { text: "中文"; }
    Card {
        Row {
            title: "默认字形";
            detail: "随时可按 Ctrl+Shift+F 切换";
            enabled: State.zh-available;
            VerticalLayout { alignment: center;
                Segmented {
                    options: ["简体", "繁體"];
                    current <=> State.zh-script;
                    enabled: State.zh-available;
                    selected => { State.zh-changed(); }
                }
            }
        }
        Divider { }
        Row {
            title: "全角标点";
            detail: "输入 ，。？ 而不是 , . ?";
            enabled: State.zh-available;
            VerticalLayout { alignment: center;
                Switch { checked <=> State.zh-full-punct; label: "全角标点"; enabled: State.zh-available; toggled => { State.zh-changed(); } }
            }
        }
        Divider { }
        Row {
            title: "候选词中显示表情";
            detail: "在有对应表情的词旁显示表情";
            enabled: State.zh-available;
            VerticalLayout { alignment: center;
                Switch { checked <=> State.zh-emoji; label: "候选词中显示表情"; enabled: State.zh-available; toggled => { State.zh-changed(); } }
            }
        }
        Divider { }
        Row {
            title: "模糊拼音";
            detail: State.fuzzy-summary;
            arrow: true;
            enabled: State.zh-available;
            clicked => { Nav.sub = 1; }
        }
        Divider { }
        Row {
            title: "我的词语";
            detail: "你自己的词，输入其拼音时排在首位";
            arrow: true;
            enabled: State.zh-available;
            clicked => { Nav.sub = 2; }
        }
    }
    SectionTitle { text: "日本語"; }
    Card {
        Row {
            title: "半角空格";
            detail: State.ja-available ? "空格键总是输入半角空格" : "未找到 Mozc";
            enabled: State.ja-available;
            VerticalLayout { alignment: center;
                Switch { checked <=> State.ja-half-space; label: "半角空格"; enabled: State.ja-available; toggled => { State.ja-changed(); } }
            }
        }
        Divider { }
        Row {
            title: "我的词语";
            detail: "Mozc 用户词典";
            arrow: true;
            enabled: State.ja-available;
            clicked => { Nav.sub = 3; }
        }
    }

    SectionTitle { text: "English"; }
    Card {
        Row { title: "系统美式键盘"; detail: "电脑上的英文是普通键盘输入，没有 SebType 的额外功能"; }
    }
}

component FuzzyPage inherits Page {
    title: "模糊拼音";
    back: true;
    Info { text: "把容易混淆的音当作同一个音，例如打 zi 也能出“知”。"; }
    Card {
        for f[i] in State.fuzzy: Row {
            title: f.label;
            VerticalLayout { alignment: center;
                Switch { checked: f.on; label: f.label; toggled(on) => { State.fuzzy-changed(i, on); } }
            }
        }
    }
}

component ZhWordsPage inherits Page {
    title: "我的词语 · 中文";
    back: true;
    property <string> word;
    property <string> code;
    Info { text: "你自己的词，例如名字。输入它的拼音时，它排在第一位。"; }
    Card {
        HorizontalLayout {
            padding: Theme.row-padding-x;
            spacing: 10px;
            Field { text <=> root.word; placeholder: "词语，例如 小明"; horizontal-stretch: 1; }
            Field { text <=> root.code; placeholder: "拼音，例如 xiaoming"; horizontal-stretch: 1; accepted => { add.clicked(); } }
            add := Button {
                text: "添加";
                primary: true;
                enabled: root.word != "" && root.code != "";
                clicked => { if State.add-zh-word(root.word, root.code) { root.word = ""; root.code = ""; } }
            }
        }
    }
    if State.zh-words.length > 0: Card {
        for w[i] in State.zh-words: Row {
            title: w.word;
            detail: w.code;
            VerticalLayout { alignment: center;
                Button { text: "删除"; clicked => { State.remove-zh-word(i); } }
            }
        }
    }
}

component JaWordsPage inherits Page {
    title: "我的词语 · 日本語";
    back: true;
    property <string> reading;
    property <string> word;
    property <int> pos;
    Info { text: "Mozc 的用户词典。读音用平假名，例如 せぶ → SebType。"; }
    Card {
        VerticalLayout {
            padding: Theme.row-padding-x;
            spacing: 10px;
            HorizontalLayout {
                spacing: 10px;
                Field { text <=> root.reading; placeholder: "読み（ひらがな）"; horizontal-stretch: 1; }
                Field { text <=> root.word; placeholder: "単語"; horizontal-stretch: 1; accepted => { add.clicked(); } }
                add := Button {
                    text: "添加";
                    primary: true;
                    enabled: root.reading != "" && root.word != "";
                    clicked => { if State.add-ja-word(root.reading, root.word, root.pos) { root.reading = ""; root.word = ""; } }
                }
            }
            HorizontalLayout {
                alignment: start;
                Segmented { options: State.ja-pos; current <=> root.pos; }
            }
        }
    }
    if State.ja-words.length > 0: Card {
        for w[i] in State.ja-words: Row {
            title: w.word;
            detail: w.reading + " · " + State.ja-pos[w.pos];
            VerticalLayout { alignment: center;
                Button { text: "删除"; clicked => { State.remove-ja-word(i); } }
            }
        }
    }
}

// The candidate window as it will look, redrawn as the settings change.
component CandidateSample inherits Rectangle {
    in property <bool> picnic: State.picnic;
    in property <bool> vertical: State.vertical;
    in property <int> count: State.page-size;
    property <[string]> words: ["你好", "拟好", "你", "呢", "👋", "泥", "尼", "妮", "倪"];
    property <length> size: State.font-size * 1px;
    background: picnic ? Theme.card : #ffffff;
    border-radius: picnic ? 10px : 2px;
    border-width: 2px;
    border-color: picnic ? Theme.outline : #c0c0c0;
    width: self.preferred-width;
    height: self.preferred-height;
    VerticalLayout {
        padding: 6px;
        spacing: 4px;
        Text { text: "ni hao"; color: picnic ? Theme.muted : #555555; font-size: root.size * 0.85; }
        if !root.vertical: HorizontalLayout {
            spacing: 6px;
            for w[i] in root.words: Rectangle {
                visible: i < root.count;
                width: i < root.count ? self.preferred-width : 0;
                background: i == 0 ? (root.picnic ? Theme.key : #808080) : transparent;
                border-radius: root.picnic ? 6px : 0;
                HorizontalLayout {
                    padding-left: 5px;
                    padding-right: 5px;
                    Text { text: (i + 1) + " " + w; color: i == 0 ? white : (root.picnic ? Theme.ink : black); font-size: root.size; }
                }
            }
        }
        if root.vertical: VerticalLayout {
            for w[i] in root.words: Rectangle {
                visible: i < root.count;
                height: i < root.count ? self.preferred-height : 0;
                background: i == 0 ? (root.picnic ? Theme.key : #808080) : transparent;
                border-radius: root.picnic ? 6px : 0;
                HorizontalLayout {
                    padding-left: 5px;
                    padding-right: 5px;
                    Text { text: (i + 1) + " " + w; color: i == 0 ? white : (root.picnic ? Theme.ink : black); font-size: root.size; }
                }
            }
        }
    }
}

component KeyboardPage inherits Page {
    title: "键盘";
    SectionTitle { text: "候选窗"; }
    Card {
        HorizontalLayout {
            padding: Theme.row-padding-x;
            height: State.vertical ? 300px : 80px;
            alignment: start;
            VerticalLayout { alignment: start; CandidateSample { } }
        }
        Divider { }
        Row {
            title: "每页候选词";
            detail: "中文（日本語固定 9 个）";
            VerticalLayout { alignment: center;
                Segmented {
                    options: ["5", "6", "7", "8", "9"];
                    current: State.page-size - 5;
                    selected(i) => { State.page-size = i + 5; State.candidates-changed(); }
                }
            }
        }
        Divider { }
        Row {
            title: "排列";
            VerticalLayout { alignment: center;
                Segmented {
                    options: ["横排", "竖排"];
                    current: State.vertical ? 1 : 0;
                    selected(i) => { State.vertical = i == 1; State.candidates-changed(); }
                }
            }
        }
        Divider { }
        Row {
            title: "字号";
            detail: State.font-size;
            HorizontalLayout { alignment: center; spacing: 8px;
                Button { text: "A−"; enabled: State.font-size > 9; clicked => { State.font-size -= 1; State.candidates-changed(); } }
                Button { text: "A+"; enabled: State.font-size < 24; clicked => { State.font-size += 1; State.candidates-changed(); } }
            }
        }
    }
    SectionTitle { text: "快捷键"; }
    Card {
        Row { title: State.system == "Windows" ? "切换语言 EN → 中 → 日" : "切换语言 EN ⇄ 上次的 中 或 日"; VerticalLayout { alignment: center; Kbd { text: "Win+Space"; } } }
        Divider { }
        Row { title: "中文或日本語里临时输入英文"; VerticalLayout { alignment: center; Kbd { text: "Shift"; } } }
        Divider { }
        Row { title: "日本語 あ ⇄ ア"; VerticalLayout { alignment: center; Kbd { text: "Alt+`"; } } }
        Divider { }
        Row { title: "简体 ⇄ 繁體"; VerticalLayout { alignment: center; Kbd { text: "Ctrl+Shift+F"; } } }
    }
}

component ThemeChoice inherits Rectangle {
    in property <string> title;
    in property <bool> picnic;
    in property <bool> selected;
    callback clicked;
    border-radius: Theme.card-radius;
    border-width: selected ? 3px : 1px;
    border-color: selected ? Theme.key : Theme.card-border;
    background: Theme.card;
    accessible-role: button;
    accessible-label: title;
    accessible-checked: selected;
    accessible-action-default => { clicked(); }
    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        alignment: start;
        HorizontalLayout { alignment: center; CandidateSample { picnic: root.picnic; vertical: false; count: 4; } }
        Text { text: (root.selected ? "● " : "○ ") + root.title; color: Theme.ink; font-size: Theme.body-size; horizontal-alignment: center; }
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component ThemePage inherits Page {
    title: "主题";
    SectionTitle { text: "候选窗"; }
    HorizontalLayout {
        spacing: Theme.card-gap;
        ThemeChoice { title: "Picnic"; picnic: true; selected: State.picnic;
            clicked => { if !State.picnic { State.picnic = true; State.theme-changed(); } } }
        ThemeChoice { title: "系统样式"; picnic: false; selected: !State.picnic;
            clicked => { if State.picnic { State.picnic = false; State.theme-changed(); } } }
    }
    Text {
        text: State.system == "Windows" ? "日本語的候选窗由 Mozc 自己绘制，保持原样。" : "中文和日本語的候选窗都使用此样式。";
        color: Theme.muted;
        font-size: Theme.detail-size;
        wrap: word-wrap;
    }
    SectionTitle { text: "托盘图标"; }
    Card {
        HorizontalLayout {
            padding: Theme.row-padding-x;
            spacing: 14px;
            alignment: start;
            for icon in [@image-url("../../icons/scalable/en.svg"), @image-url("../../icons/scalable/zh.svg"),
                    @image-url("../../icons/scalable/zh-a.svg"), @image-url("../../icons/scalable/zh-A.svg"),
                    @image-url("../../icons/scalable/hira.svg"), @image-url("../../icons/scalable/kata.svg"),
                    @image-url("../../icons/scalable/ja-a.svg"), @image-url("../../icons/scalable/ja-A.svg")]:
                Image { source: icon; width: 40px; height: 40px; }
        }
        Row { title: "SebType 的按键图标"; detail: "EN、中、あ、ア，以及中文和日本語英文模式下的 a / A（大写锁定）"; }
    }
}

component PrivacyPage inherits Page {
    title: "隐私";
    Card {
        Row {
            title: "从我的输入中学习";
            detail: "中文和日本語记住你选过的词，下次排在前面";
            VerticalLayout { alignment: center;
                Switch { checked <=> State.learn; label: "从我的输入中学习"; toggled => { State.learn-changed(); } }
            }
        }
    }
    SectionTitle { text: "忘记已学的词"; }
    Card {
        Row {
            title: "中文";
            detail: "删除 Rime 学到的词；你自己的词保留";
            enabled: State.zh-available;
            VerticalLayout { alignment: center;
                Button { text: "忘记…"; enabled: State.zh-available; clicked => { Nav.confirm-lang = "zh"; } }
            }
        }
        Divider { }
        Row {
            title: "日本語";
            detail: "删除 Mozc 的输入历史；用户词典保留";
            enabled: State.ja-available;
            VerticalLayout { alignment: center;
                Button { text: "忘记…"; enabled: State.ja-available; clicked => { Nav.confirm-lang = "ja"; } }
            }
        }
    }
    Text {
        text: "剪贴板历史由系统提供（" + (State.system == "Windows" ? "Win+V" : "Klipper") + "），这里没有。";
        color: Theme.muted;
        font-size: Theme.detail-size;
        wrap: word-wrap;
    }
}

component SyncPage inherits Page {
    title: "同步与备份";
    SectionTitle { text: "同步"; }
    Card {
        Row {
            title: "与我的服务器同步";
            detail: "即将推出：已学的词和你自己的词在手机和电脑之间同步";
            enabled: false;
            VerticalLayout { alignment: center; Switch { enabled: false; label: "与我的服务器同步"; } }
        }
        Divider { }
        Row {
            title: "删除服务器上已学的词";
            detail: "只删除服务器上的副本，本机的词不变（同步推出后可用）";
            enabled: false;
            VerticalLayout { alignment: center; Button { text: "删除…"; danger: true; enabled: false; } }
        }
    }
    SectionTitle { text: "备份"; }
    Card {
        Row {
            title: "导出设置";
            detail: "所有设置和你自己的词，保存为一个文件";
            VerticalLayout { alignment: center; Button { text: "导出…"; clicked => { State.export-settings(); } } }
        }
        Divider { }
        Row {
            title: "导入设置";
            detail: "从导出的文件恢复";
            VerticalLayout { alignment: center; Button { text: "导入…"; clicked => { State.import-settings(); } } }
        }
    }
}

component AboutPage inherits Page {
    title: "关于";
    Card {
        HorizontalLayout {
            padding: Theme.row-padding-x;
            spacing: 14px;
            alignment: start;
            Rectangle {
                width: 64px; height: 64px; border-radius: 32px; background: #FFE4EC; clip: true;
                Image { source: @image-url("../../../sebtype/res-stable/mipmap-xxxhdpi/ic_launcher_round.png"); width: 64px; height: 64px; }
            }
            VerticalLayout { alignment: center;
                PageTitle { text: "SebType Configurator"; font-size: 18px; }
                Text { text: "版本 " + State.version + " · " + State.system; color: Theme.muted; font-size: Theme.detail-size; }
            }
        }
    }
    Card {
        Row { title: "帮助与反馈"; detail: "SebType 在 GitHub 上的问题页"; arrow: true; clicked => { State.open-help(); } }
        Divider { }
        Row {
            title: "重新部署";
            detail: "重新应用所有设置，中文需要几秒";
            VerticalLayout { alignment: center; Button { text: "重新部署"; clicked => { State.redeploy(); } } }
        }
    }
    SectionTitle { text: "许可与致谢"; }
    Card {
        Row { title: "雾凇拼音 rime-ice · 白霜拼音 rime-frost"; detail: "GPL-3.0"; }
        Divider { }
        Row { title: "Rime (librime)" + (State.system == "Windows" ? " · 小狼毫 Weasel" : " · Fcitx5 · fcitx5-rime"); detail: State.system == "Windows" ? "BSD-3-Clause · GPL-3.0" : "BSD-3-Clause · LGPL-2.1+"; }
        Divider { }
        Row { title: "Mozc"; detail: "BSD-3-Clause"; }
        Divider { }
        Row { title: "Nunito"; detail: "SIL Open Font License 1.1"; }
        HorizontalLayout { padding: Theme.row-padding-x; alignment: start; AboutSlint { } }
    }
}

export component Pages inherits Rectangle {
    if Nav.page == 0 && Nav.sub == 0: LanguagesPage { }
    if Nav.page == 0 && Nav.sub == 1: FuzzyPage { }
    if Nav.page == 0 && Nav.sub == 2: ZhWordsPage { }
    if Nav.page == 0 && Nav.sub == 3: JaWordsPage { }
    if Nav.page == 1: KeyboardPage { }
    if Nav.page == 2: ThemePage { }
    if Nav.page == 3: PrivacyPage { }
    if Nav.page == 4: SyncPage { }
    if Nav.page == 5: AboutPage { }
}
