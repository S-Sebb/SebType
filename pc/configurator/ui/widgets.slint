import { Theme } from "theme.slint";

export component Switch inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    in property <string> label;
    callback toggled(bool);
    width: 46px;
    height: 26px;
    border-radius: 13px;
    background: checked ? Theme.key : Theme.off-track;
    border-width: checked ? 0 : 2px;
    border-color: Theme.outline;
    opacity: enabled ? 1 : 0.45;
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-label: label;
    accessible-action-default => { if enabled { checked = !checked; toggled(checked); } }
    Rectangle {
        width: root.checked ? 20px : 14px;
        height: self.width;
        border-radius: self.width / 2;
        background: root.checked ? white : Theme.outline;
        x: root.checked ? parent.width - self.width - 3px : 5px;
        y: (parent.height - self.height) / 2;
        animate x, width { duration: 120ms; }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.checked = !root.checked; root.toggled(root.checked); }
    }
}

export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current;
    in property <bool> enabled: true;
    callback selected(int);
    height: 30px;
    border-width: 2px;
    border-color: Theme.outline;
    border-radius: 15px;
    opacity: enabled ? 1 : 0.45;
    HorizontalLayout {
        padding: 2px;
        for o[i] in root.options: Rectangle {
            border-radius: 12px;
            background: i == root.current ? Theme.key : transparent;
            min-width: 40px;
            accessible-role: button;
            accessible-label: o;
            accessible-checked: i == root.current;
            accessible-action-default => { if root.enabled { root.current = i; root.selected(i); } }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    text: o;
                    color: i == root.current ? white : Theme.ink;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
            TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                clicked => { root.current = i; root.selected(i); }
            }
        }
    }
}

// The Picnic keys' notched pixel frame (PixelFrame in java/.../theme/Picnic.kt), rect for rect: an
// outline with its corners cut away, a highlight top-left and lowlight bottom-right inside, and a hard
// shadow in the last frame width right and below. The children keep clear of all of it.
export component PixelFrame inherits Rectangle {
    in property <color> fill: Theme.card;
    in property <color> outline: Theme.outline;
    in property <bool> shadow: true;
    in property <bool> pressed;   // pushed in: the bevel flips and the shadow goes, as on the keys
    in property <length> padding-x;
    in property <length> padding-y;
    property <length> w: Theme.frame;
    // As the phone's settings: the highlight is the fill 85 % of the way to white, the lowlight the line.
    property <color> high: pressed ? Theme.line : fill.mix(white, 0.15);
    property <color> low: pressed ? fill.mix(white, 0.15) : Theme.line;
    if root.shadow && !root.pressed: Rectangle { x: root.width - root.w; y: 3 * root.w; width: root.w; height: root.height - 3 * root.w; background: Theme.drop; }
    if root.shadow && !root.pressed: Rectangle { x: 3 * root.w; y: root.height - root.w; width: root.width - 4 * root.w; height: root.w; background: Theme.drop; }
    Rectangle { x: root.w; y: root.w; width: root.width - 3 * root.w; height: root.height - 3 * root.w; background: root.fill; }
    Rectangle { x: root.w; y: root.height - 3 * root.w; width: root.width - 3 * root.w; height: root.w; background: root.low; }
    Rectangle { x: root.width - 3 * root.w; y: root.w; width: root.w; height: root.height - 3 * root.w; background: root.low; }
    Rectangle { x: root.w; y: root.w; width: root.width - 3 * root.w; height: root.w; background: root.high; }
    Rectangle { x: root.w; y: root.w; width: root.w; height: root.height - 3 * root.w; background: root.high; }
    Rectangle { x: root.w; y: 0; width: root.width - 3 * root.w; height: root.w; background: root.outline; }
    Rectangle { x: root.w; y: root.height - 2 * root.w; width: root.width - 3 * root.w; height: root.w; background: root.outline; }
    Rectangle { x: 0; y: root.w; width: root.w; height: root.height - 3 * root.w; background: root.outline; }
    Rectangle { x: root.width - 2 * root.w; y: root.w; width: root.w; height: root.height - 3 * root.w; background: root.outline; }
    VerticalLayout {
        padding-left: 2 * root.w + root.padding-x;
        padding-right: 3 * root.w + root.padding-x;
        padding-top: 2 * root.w + root.padding-y;
        padding-bottom: 3 * root.w + root.padding-y;
        @children
    }
}

// One item: a group of rows in a cream frame, a Divider between rows.
export component Card inherits PixelFrame { }

// The dashed line between a card's rows.
export component Divider inherits Rectangle {
    height: Theme.frame;
    Image {
        x: Theme.dash-inset;
        width: parent.width - 2 * Theme.dash-inset;
        height: parent.height;
        source: @image-url("dash.svg");
        horizontal-tiling: repeat;
        image-rendering: pixelated;
    }
}

export component Row inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> enabled: true;
    in property <bool> arrow;
    in property <bool> line-above;   // a Divider over the row, for rows made by a for
    callback clicked;
    min-height: Theme.row-min-height;
    opacity: enabled ? 1 : 0.5;
    if root.line-above: Divider { y: 0; width: parent.width; }
    if root.arrow: Rectangle {
        accessible-role: button;
        accessible-label: root.title;
        accessible-description: root.detail;
        accessible-enabled: root.enabled;
        accessible-action-default => { if root.enabled { root.clicked(); } }
        TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }
    HorizontalLayout {
        padding-left: Theme.row-padding-x;
        padding-right: Theme.row-padding-x;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;
            Text { text: root.title; color: Theme.ink; font-size: Theme.body-size; wrap: word-wrap; }
            if root.detail != "": Text { text: root.detail; color: Theme.muted; font-size: Theme.detail-size; wrap: word-wrap; }
        }
        @children
        if root.arrow: Text { text: "→"; color: Theme.ink; font-size: 18px; vertical-alignment: center; }
    }
}

// A section header: a pink tag framed like the keys, as wide as its text.
export component SectionTag inherits HorizontalLayout {
    in property <string> text;
    alignment: start;
    padding-top: 4px;
    PixelFrame {
        fill: Theme.pink;
        padding-x: 10px;
        padding-y: 3px;
        accessible-role: AccessibleRole.text;
        accessible-label: root.text;
        Text { text: root.text; color: Theme.ink; font-size: Theme.section-size; font-weight: 700; }
    }
}

export component PageTitle inherits Text {
    color: Theme.ink;
    font-family: Theme.title-font;
    font-size: Theme.title-size;
    font-weight: 800;
}

// A tip: a pink frame.
export component Info inherits PixelFrame {
    in property <string> text;
    fill: Theme.pink;
    padding-x: 10px;
    padding-y: 8px;
    Text { text: root.text; color: Theme.ink; font-size: Theme.detail-size; wrap: word-wrap; }
}

// A button is a Picnic key: cream, or the pink key's colour when it's the main one.
export component Button inherits PixelFrame {
    in property <string> text;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> enabled: true;
    callback clicked;
    height: 34px;
    fill: !enabled ? Theme.off-track : primary ? (touch.has-hover ? Theme.key-high : Theme.key) : danger ? Theme.danger : (touch.has-hover ? Theme.pink : Theme.card);
    pressed: touch.pressed;
    padding-x: 12px;
    opacity: enabled ? 1 : 0.6;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { if enabled { clicked(); } }
    Rectangle {
        Text {
            text: root.text;
            color: root.enabled && (root.primary || root.danger) ? white : Theme.ink;
            font-size: 13.5px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
        touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }
}

// A key cap, framed as the keyboard's keys.
export component Kbd inherits PixelFrame {
    in property <string> text;
    height: 30px;
    padding-x: 8px;
    Text { text: root.text; color: Theme.ink; font-size: 12px; font-weight: 700; vertical-alignment: center; }
}

export component Field inherits PixelFrame {
    in-out property <string> text;
    in property <string> placeholder;
    in property <InputType> input-type: InputType.text;
    callback accepted;
    height: 36px;
    fill: white;
    shadow: false;
    outline: input.has-focus ? Theme.key : Theme.outline;
    padding-x: 8px;
    accessible-role: text-input;
    accessible-label: placeholder;
    accessible-value: text;
    Rectangle {
        input := TextInput {
            text <=> root.text;
            color: Theme.ink;
            font-size: 14px;
            vertical-alignment: center;
            single-line: true;
            input-type: root.input-type;
            accepted => { root.accepted(); }
        }
        if root.text == "": Text {
            x: 1px;
            width: parent.width;
            text: root.placeholder;
            color: Theme.muted;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// The bar with a page's title, as the phone's: cream, with the frames' outline under it.
export component TitleBar inherits Rectangle {
    in property <string> text;
    in property <bool> back;
    callback go-back;
    height: Theme.title-bar-height;
    background: Theme.card;
    HorizontalLayout {
        padding-left: root.back ? 12px : Theme.page-padding;
        padding-right: Theme.page-padding;
        padding-bottom: Theme.frame;
        spacing: 8px;
        if root.back: Rectangle {
            width: 34px;
            height: 34px;
            y: (parent.height - self.height) / 2;
            border-radius: 17px;
            background: back-touch.has-hover ? Theme.pink : transparent;
            accessible-role: button;
            accessible-label: @tr("Back");
            accessible-action-default => { root.go-back(); }
            Text { text: "←"; color: Theme.ink; font-size: 20px; }
            back-touch := TouchArea { mouse-cursor: pointer; clicked => { root.go-back(); } }
        }
        PageTitle { text: root.text; vertical-alignment: center; overflow: elide; }
    }
    Rectangle { y: parent.height - Theme.frame; height: Theme.frame; background: Theme.outline; }
}
