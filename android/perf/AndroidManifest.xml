<?xml version="1.0" encoding="utf-8"?>
<!-- Test field for android/perf/perf.sh, built with the SDK's own tools (no Gradle). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.sebb.sebtype.perffield">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35" />
    <application android:label="SebType perf field" android:allowBackup="false">
        <profileable android:shell="true" />
        <!-- Portrait, as perf.sh's key grid is: a phone on its side with auto-rotate on would otherwise put the field
             and keyboard in landscape, and the taps would land on other windows (#402) -->
        <activity android:name=".PerfField" android:exported="true" android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The PNG the "clipimage" extra copies (#281): a throwaway test app's, readable by any app -->
        <provider android:name=".PerfField$ImageProvider" android:authorities="dev.sebb.sebtype.perffield.image"
            android:exported="true" />
    </application>
</manifest>
