<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: main's config, plus plain HTTP to the emulator's 127.0.0.1, where android/test/update.sh
     serves a test release through adb reverse (#422). Release builds keep main's. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
